<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#10251f">
  <title>Panda Drive · Bloque 6.5</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
<div class="shell">

  <header class="header">
    <div>
      <strong>🐼 PANDA DRIVE</strong>
      <small>Fusagasugá · Bloque 6.5 · conexión y minimapa</small>
    </div>
    <button id="logout" class="btn secondary hide">Cerrar sesión</button>
  </header>

  <div id="msg" class="note">Preparando conexión segura…</div>

  <!-- ACCESO -->
  <section id="auth" class="panel">
    <div class="panel-head"><h2>Acceso a Panda Drive</h2></div>
    <div class="quick-body">
      <div class="tabs">
        <button id="tab-login" class="active">Ingresar</button>
        <button id="tab-register">Crear cuenta</button>
      </div>

      <form id="login-form">
        <div class="field"><label>Correo electrónico</label>
          <input id="email" type="email" autocomplete="email" required></div>
        <div class="field"><label>Contraseña</label>
          <input id="password" type="password" autocomplete="current-password" required></div>
        <button class="btn full" type="submit">Ingresar</button>
      </form>

      <form id="register-form" class="hide">
        <div class="field"><label>Tipo de cuenta</label>
          <select id="reg-role">
            <option value="restaurant">Restaurante aliado</option>
            <option value="rider">Domiciliario</option>
          </select></div>
        <div class="field"><label>Nombre del negocio o persona</label>
          <input id="reg-name" required></div>
        <div class="field"><label>Correo electrónico</label>
          <input id="reg-email" type="email" required></div>
        <div class="field"><label>Contraseña (mínimo 8 caracteres)</label>
          <input id="reg-password" type="password" minlength="8" required></div>
        <div class="field"><label>Teléfono</label>
          <input id="reg-phone" type="tel" required></div>
        <div class="field"><label id="extra-label">Dirección del restaurante en Fusagasugá</label>
          <input id="reg-extra" required></div>
        <button class="btn full" type="submit">Registrar solicitud</button>
        <p class="muted">El coordinador deberá aprobar tu cuenta. Si Supabase requiere confirmar el correo, revisa tu bandeja de entrada.</p>
      </form>
    </div>
  </section>

  <!-- PENDIENTE -->
  <section id="pending" class="panel hide">
    <div class="panel-head"><h2>Solicitud en revisión</h2></div>
    <div class="quick-body">
      <p id="pending-text"></p>
      <button class="btn secondary" id="retry">Consultar estado de mi cuenta</button>
    </div>
  </section>

  <!-- APP -->
  <section id="app" class="hide">
    <div class="panel">
      <div class="quick-body">
        <div class="toolbar">
          <b id="who"></b>
          <span class="tag" id="role-tag"></span>
          <button id="refresh" class="btn secondary">Actualizar datos</button>
        </div>
        <div id="subscription" class="note"></div>
      </div>
    </div>

    <!-- Restaurante -->
    <div id="restaurant-panel" class="hide">
      <div class="grid2">
        <div class="panel">
          <div class="panel-head"><h2>📲 Solicitar domicilio</h2></div>
          <div class="quick-body">
            <div class="nfc">
              <div class="nfc-icon">📲</div>
              <b>Acerca el chip NFC a tu celular</b>
              <small>El restaurante debe tener sesión iniciada. El chip debe estar vinculado al establecimiento.</small>
            </div>
            <button id="nfc-start" class="btn full">Activar lector NFC</button>
            <p class="muted" id="nfc-status">La lectura NFC requiere Chrome Android compatible, HTTPS y permiso del navegador.</p>
            <button id="request" class="btn secondary full">Simular toque NFC (prueba)</button>
            <p class="muted">La simulación crea una solicitud real en Supabase. Requiere habilitación temporal en la base de datos; úsala únicamente para pruebas.</p>
          </div>
        </div>

        <div class="panel">
          <div class="panel-head"><h2>🏪 Mi restaurante</h2></div>
          <div class="quick-body">
            <div id="my-store"></div>
            <button id="store-gps" class="btn secondary full" type="button" style="margin-top:12px">📍 Guardar ubicación del restaurante</button>
            <p id="store-gps-status" class="muted" aria-live="polite">Aún no hay coordenadas guardadas.</p>
            <div id="store-mini-map" class="map-wrap" style="height:260px;min-height:260px;margin-top:12px" aria-label="Mapa de ubicación del restaurante"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Domiciliario -->
    <div id="rider-panel" class="hide">
      <div class="grid2">
        <div class="panel">
          <div class="panel-head"><h2>🛵 Mi disponibilidad</h2></div>
          <div class="quick-body">
            <div class="field"><label>Estado</label>
              <select id="availability">
                <option value="offline">Desconectado</option>
                <option value="available">Disponible</option>
                <option value="busy">En servicio</option>
              </select></div>
            <button class="btn" id="save-availability">Guardar en Supabase</button>
            <button class="btn secondary" id="gps">Compartir mi ubicación GPS</button>
            <button class="btn secondary" id="gps-stop">Detener GPS</button>
            <p class="muted" id="gps-status">El GPS requiere HTTPS y permiso del dispositivo.</p>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head"><h2>📍 Mi posición</h2></div>
          <div class="quick-body">
            <div id="my-location" class="muted">Sin ubicación registrada</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Coordinador -->
    <div id="operator-panel" class="hide">
      <div class="grid2">
        <div class="panel">
          <div class="panel-head"><h2>👥 Solicitudes y perfiles</h2></div>
          <div class="quick-body">
            <p class="muted">Aprueba únicamente solicitudes verificadas. Las cuentas pendientes no pueden operar.</p>
            <div id="accounts"></div>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head"><h2>💳 Suscripciones</h2></div>
          <div class="quick-body">
            <p class="muted">Solo restaurantes y domiciliarios pagan membresía.</p>
            <div id="memberships"></div>
          </div>
        </div>
      </div>
      <div class="panel">
        <div class="panel-head"><h2>🛵 Domiciliarios y GPS</h2></div>
        <div class="quick-body" id="operator-riders"></div>
      </div>
    </div>

    <!-- Servicios -->
    <div class="panel">
      <div class="panel-head">
        <h2>📦 Servicios</h2>
        <span class="tag">Guardados en PostgreSQL</span>
      </div>
      <div class="quick-body" id="orders"></div>
    </div>

    <div class="grid2">
      <div class="panel">
        <div class="panel-head"><h2>⚑ Reportar novedad</h2></div>
        <div class="quick-body">
          <div class="field"><label>Tipo</label>
            <select id="issue-type">
              <option>Dirección incorrecta</option>
              <option>Cliente no responde</option>
              <option>Demora en preparación</option>
              <option>Problema con el pedido</option>
              <option>Otro</option>
            </select></div>
          <div class="field"><label>Descripción</label>
            <textarea id="issue-text" rows="3"></textarea></div>
          <button class="btn" id="issue-send">Registrar novedad</button>
          <div id="issues"></div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><h2>🗺️ Mapa de ubicaciones registradas</h2></div>
        <div class="quick-body">
          <div class="map-wrap" id="map"></div>
          <p class="muted">Solo se muestran coordenadas realmente guardadas. Las rutas se consultan externamente cuando hay coordenadas.</p>
          <div id="map-status" class="muted"></div>
        </div>
      </div>
    </div>
  </section>

  <p class="muted" style="margin:18px 2px">Bloque 6: NFC y asignación automática para pruebas. Ejecutar primero la migración SQL correspondiente. No publicar para uso comercial hasta completar auditoría de permisos, asignación, pagos y pruebas con varios dispositivos.</p>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script src="js/app.js"></script>
</body>
</html>